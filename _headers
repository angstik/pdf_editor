# =====================================================================
# EDITION PDF — en-têtes servis par Cloudflare (Workers static assets / Pages)
# Les règles sont cumulatives : /* d'abord, puis les surcharges par chemin.
# =====================================================================

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), usb=(), payment=(), display-capture=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'

# Le document et les métadonnées PWA doivent être revalidés à chaque chargement,
# sinon une nouvelle livraison reste invisible pendant la durée du cache navigateur.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

# Le service worker pilote lui-même les mises à jour : il ne doit jamais être figé.
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

# Le code applicatif n'a pas de nom versionné : revalidation systématique (304 la plupart du temps).
/assets/js/*
  Cache-Control: no-cache

/assets/css/*
  Cache-Control: no-cache

/assets/icons/*
  Cache-Control: public, max-age=604800

# Librairies figées (pdf.js 3.11.174, pdf-lib 1.17.1) : immuables.
# Si vous montez de version, renommez le dossier (vendor-2/) ou retirez `immutable`.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
